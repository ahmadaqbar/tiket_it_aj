# =====================================================================
# ALMEGA IT TICKETING SYSTEM — contoh konfigurasi environment
# Salin menjadi .env lalu sesuaikan. JANGAN commit file .env.
# =====================================================================
APP_NAME="ALMEGA IT TICKETING SYSTEM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Production: APP_ENV=production, APP_DEBUG=false, APP_URL=https://it.almegajaya.com
APP_URL=http://localhost:8000

# Asia/Jakarta (WIB) atau Asia/Makassar (WITA)
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=almega_it_ticketing
DB_USERNAME=root
DB_PASSWORD=

# Shared hosting: semua driver memakai database/file (tanpa Redis)
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production (HTTPS): true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="it@almegajaya.com"
MAIL_FROM_NAME="${APP_NAME}"

# Akun IT Admin awal (dipakai oleh `php artisan db:seed`).
# Jika INITIAL_ADMIN_PASSWORD kosong, password acak akan dibuat dan ditampilkan sekali di console.
# PENTING: bungkus nilai yang mengandung #, spasi, atau $ dengan tanda kutip ganda, mis. "Rahasia#2026".
INITIAL_ADMIN_NAME="IT Administrator"
INITIAL_ADMIN_USERNAME=itadmin
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"

# =====================================================================
# AI (OPSIONAL) — core ticketing tetap berjalan tanpa AI.
# Aktif bila AI_API_KEY + model terisi DAN IT Admin menyalakan "Asisten AI" di System Settings.
# API key hanya di sini (tidak disimpan di database/HTML/log). Lihat AI_INTEGRATION_GUIDE.md.
# =====================================================================
AI_PROVIDER=anthropic
AI_API_KEY=
# Kosong = default provider (anthropic: claude-opus-5-5). Untuk openai_compatible WAJIB diisi.
AI_MODEL=
AI_BASE_URL=
AI_TIMEOUT=30
AI_MAX_OUTPUT_TOKENS=1200
AI_RATE_PER_USER_PER_HOUR=30
AI_DAILY_LIMIT=300

# Edisi: almega (Edisi Internal PT Almega Jaya Group) | product (Edisi produk untuk organisasi lain)
HELPDESK_EDITION=almega
